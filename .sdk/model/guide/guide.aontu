# Guide

@"@voxgig/apidef/model/guide.aontu"

@"./base-guide.aontu"





# Corrections to the heuristic classification.
#
# Honeycomb scopes most resources to a dataset: /1/<things>/{datasetSlug}
# lists them (the GET returns an array) and /1/<things>/{datasetSlug}/{id}
# addresses one. The heuristic reads the trailing {datasetSlug} as the
# resource id, so the list becomes a load and the real id is never "id".
# Each entry below restores list(dataset_slug) and load(dataset_slug, id).

guide: entity: burn_alert: {
  path: "/1/burn_alerts/{datasetSlug}": {
    rename: param: "datasetSlug": "dataset_slug"
    op: load: active: false
    op: list: method: "GET"
  }
  path: "/1/burn_alerts/{datasetSlug}/{burnAlertId}": rename: param: "burnAlertId": "id"
}

guide: entity: calculated_field: {
  path: "/1/derived_columns/{datasetSlug}": {
    rename: param: "datasetSlug": "dataset_slug"
    op: load: active: false
    op: list: method: "GET"
  }
  path: "/1/derived_columns/{datasetSlug}/{derivedColumnId}": rename: param: "derivedColumnId": "id"
}

guide: entity: column: {
  path: "/1/columns/{datasetSlug}": {
    rename: param: "datasetSlug": "dataset_slug"
    op: load: active: false
    op: list: method: "GET"
  }
  path: "/1/columns/{datasetSlug}/{columnId}": rename: param: "columnId": "id"
}

guide: entity: marker: {
  path: "/1/markers/{datasetSlug}": {
    rename: param: "datasetSlug": "dataset_slug"
    op: load: active: false
    op: list: method: "GET"
  }
  path: "/1/markers/{datasetSlug}/{markerId}": rename: param: "markerId": "id"
}

guide: entity: marker_setting: {
  path: "/1/marker_settings/{datasetSlug}": {
    rename: param: "datasetSlug": "dataset_slug"
    op: load: active: false
    op: list: method: "GET"
  }
  path: "/1/marker_settings/{datasetSlug}/{markerSettingId}": rename: param: "markerSettingId": "id"
}

guide: entity: query_annotation: {
  path: "/1/query_annotations/{datasetSlug}": {
    rename: param: "datasetSlug": "dataset_slug"
    op: load: active: false
    op: list: method: "GET"
  }
  path: "/1/query_annotations/{datasetSlug}/{queryAnnotationId}": rename: param: "queryAnnotationId": "id"
}

guide: entity: slo: {
  path: "/1/slos/{datasetSlug}": {
    rename: param: "datasetSlug": "dataset_slug"
    op: load: active: false
    op: list: method: "GET"
  }
  path: "/1/slos/{datasetSlug}/{sloId}": rename: param: "sloId": "id"
}

guide: entity: trigger: {
  path: "/1/triggers/{datasetSlug}": {
    rename: param: "datasetSlug": "dataset_slug"
    op: load: active: false
    op: list: method: "GET"
  }
  path: "/1/triggers/{datasetSlug}/{triggerId}": rename: param: "triggerId": "id"
}

# Create-only collections: the dataset slug is a scope, not the id.

guide: entity: query: {
  path: "/1/queries/{datasetSlug}": rename: param: "datasetSlug": "dataset_slug"
  path: "/1/queries/{datasetSlug}/{queryId}": rename: param: "queryId": "id"
}

guide: entity: query_result: {
  path: "/1/query_results/{datasetSlug}": rename: param: "datasetSlug": "dataset_slug"
  path: "/1/query_results/{datasetSlug}/{queryResultId}": rename: param: "queryResultId": "id"
}

guide: entity: event: path: "/1/events/{datasetSlug}": rename: param: "datasetSlug": "dataset_slug"

# "kinesis_events" was singularised to "kinesi".
guide: entity: kinesi: active: false
guide: entity: kinesis_event: {
  path: "/1/kinesis_events/{datasetSlug}": {
    rename: param: "datasetSlug": "dataset_slug"
    op: create: method: "POST"
  }
}

# Board views: the board id is a scope, and deleting a view belongs to the
# view, not to the board.
guide: entity: board: path: "/1/boards/{boardId}/views/{viewId}": active: false
guide: entity: board_view: {
  path: "/1/boards/{boardId}/views": rename: param: "boardId": "board_id"
  path: "/1/boards/{boardId}/views/{viewId}": op: remove: method: "DELETE"
}

# GET /1/auth (configuration key) and GET /2/auth (management key) collide
# on one selector. Give the management-key endpoint its own entity.
guide: entity: auth: path: "/2/auth": active: false
guide: entity: management_auth: {
  path: "/2/auth": op: load: method: "GET"
}
