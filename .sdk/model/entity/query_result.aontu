# Entity: query_result

main: kit: entity: query_result: {

  alias: field: {}

  fields: {
    complete: {
      h: "Complete"
      n: "complete"
      r: false
      ro: true
      sh: "Indicates if the query results are available yet or not."
      t: "`$BOOLEAN`"
    }
    data: {
      h: "Data"
      n: "data"
      r: false
      sh: "An object containing the query result data"
      t: "`$OBJECT`"
    }
    disable_other_by_aggregate: {
      h: "Disable Other By Aggregate"
      n: "disable_other_by_aggregate"
      r: false
      sh: "If true, the \"other_by_aggregate\" data is excluded from the query result."
      t: "`$BOOLEAN`"
      wo: true
    }
    disable_series: {
      h: "Disable Series"
      n: "disable_series"
      r: false
      sh: "If `true`, timeseries data will not be returned in the `series` response field, and only summarized data will be returned in the `results` response field."
      t: "`$BOOLEAN`"
      wo: true
    }
    disable_total_by_aggregate: {
      h: "Disable Total By Aggregate"
      n: "disable_total_by_aggregate"
      r: false
      sh: "If `true`, data representing each aggregate in the query's total value will not be returned."
      t: "`$BOOLEAN`"
      wo: true
    }
    error: {
      h: "Error"
      n: "error"
      r: false
      ro: true
      sh: "Only present if the query failed to run."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      ro: true
      sh: "The unique identifier (ID) of a Query Result"
      t: "`$STRING`"
    }
    limit: {
      h: "Limit"
      n: "limit"
      r: false
      sh: "If `disable_series` is `true`, a limit may be optionally given."
      t: "`$INTEGER`"
      wo: true
    }
    links: {
      h: "Links"
      n: "links"
      r: false
      sh: "An object containing UI links to the query result and query result graph"
      t: "`$OBJECT`"
    }
    query: {
      h: "Query"
      n: "query"
      r: false
      ro: true
      t: "`$ANY`"
      union: {
        branches: 5
        count: 2
        depth: 10
      }
    }
    query_id: {
      h: "Query Id"
      n: "query_id"
      r: true
      sh: "The ID of a query returned from the [Queries endpoint](/api/queries/)."
      t: "`$STRING`"
      wo: true
    }
  }

  id: {
    field: "id"
    name: "id"
    parts: [
      "dataset_slug"
      "query_result_id"
    ]
    sep: "/"
  }

  name: "query_result"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "disable_other_by_aggregate"
            "disable_series"
            "disable_total_by_aggregate"
            "limit"
            "query_id"
          ]
          co: {
            id: "POST /1/query_results/{datasetSlug}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "datasetSlug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/1/query_results/{datasetSlug}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              datasetSlug: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "1"
            }
            {
              lit: "query_results"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /1/query_results/{datasetSlug}/{queryResultId}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "dataset_slug"
                or: "datasetSlug"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "query_result_id"
                or: "queryResultId"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/1/query_results/{datasetSlug}/{queryResultId}"
          q: {
            exist: [
              "dataset_slug"
              "query_result_id"
            ]
          }
          r: {
            param: {
              datasetSlug: "dataset_slug"
              queryResultId: "query_result_id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "1"
            }
            {
              lit: "query_results"
            }
            {
              var: "dataset_slug"
            }
            {
              var: "query_result_id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
