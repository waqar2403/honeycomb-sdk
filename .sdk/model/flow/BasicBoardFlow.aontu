# BasicBoardFlow

main: kit: flow: BasicBoardFlow:
{
  entity: "board",
  kind: "basic",
  name: "BasicBoardFlow",
  step: [
    {
      i: {
        ref: "board_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "board_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "board_ref01",
        srcdatavar: "board_ref01_data",
        suffix: "_up0",
        textfield: "description"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-board_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "board_ref01",
        srcdatavar: "board_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "board01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-board_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "board_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "board01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "board_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBoardFlow"
}